        </MultiTrigger>
        <Trigger Property="UIElement.IsEnabled" Value="false">
          <Setter TargetName="BulletImage" Property="UIElement.Opacity" Value="0.25"/>
          <Setter TargetName="BulletContent" Property="UIElement.Opacity" Value="0.25"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Control.Template>
