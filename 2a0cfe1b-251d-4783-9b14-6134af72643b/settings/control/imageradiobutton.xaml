                                                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                                     xmlns:ll111l1="http://schemas.microsoft.com/winfx/2006/xaml"
                                                                     RenderOptions.BitmapScalingMode="HighQuality">
  <Control.Template>
    <ControlTemplate TargetType="{Type RadioButton}">
      <BulletDecorator Background="Transparent">
        <BulletDecorator.Bullet>
          <Grid Width="38" Height="22">
            <Rectangle ll111l1:Name="CheckMark" StrokeThickness="2"
                       Stroke="{DynamicResource {Static JetSystemColors.HighlightBrushKey}}"/>
            <Image ll111l1:Name="BulletImage" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={Type lli11lllli:dje_zTVJ5M4YFM23MGGPU73KRKQ6PSLYQ6W8XYP4HQ65MAGVMLHQ_ejd}}, Path=PreviewImage}"/>
            <ContentControl ll111l1:Name="BulletContent" Margin="3"
                            ContentTemplate="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={Type lli11lllli:dje_zTVJ5M4YFM23MGGPU73KRKQ6PSLYQ6W8XYP4HQ65MAGVMLHQ_ejd}}, Path=PreviewTemplate}"/>
          </Grid>
        </BulletDecorator.Bullet>
      </BulletDecorator>
      <ControlTemplate.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="ToggleButton.IsChecked" Value="false"/>
            <Condition Property="UIElement.IsMouseOver" Value="false"/>
          </MultiTrigger.Conditions>
          <MultiTrigger.Setters>
            <Setter TargetName="CheckMark" Property="UIElement.Visibility" Value="Collapsed"/>
          </MultiTrigger.Setters>
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="ToggleButton.IsChecked" Value="false"/>
