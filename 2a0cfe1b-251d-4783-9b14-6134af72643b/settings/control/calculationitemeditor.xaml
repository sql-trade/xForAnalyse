<lli11lllli:dje_zG426HU5Y8N752U5TZBUUJVF6MWT4V73ZENJRRWJARDSY96Z_ejd xmlns:lli11lllli="clr-namespace:-"
                                                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                                     xmlns:ll111l1="http://schemas.microsoft.com/winfx/2006/xaml"
                                                                     HorizontalAlignment="Stretch" Height="24">
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*" MinWidth="90"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="60"/>
    </Grid.ColumnDefinitions>
    <DataGridCell Grid.Row="0" Grid.Column="0" IsHitTestVisible="True" BorderThickness="0"
                  ToolTip="{Binding EnableDisableDescription}"/>
    <ContentControl Grid.Column="0" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"
                    VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="0">
      <FrameworkElement.Style>
        <Style TargetType="{Type ContentControl}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Enabled}" Value="False">
              <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Enabled}" Value="True">
              <Setter Property="UIElement.Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Canvas>
        <Path Data="M 0,7 L 4,13 12,0 " Canvas.Left="2" Canvas.Top="1" StrokeThickness="2"
              StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stroke="#FF41BE9A"/>
      </Canvas>
    </ContentControl>
    <ContentControl Grid.Column="0" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"
                    VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="0">
      <Canvas>
        <FrameworkElement.Style>
          <Style TargetType="{Type Canvas}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="UIElement.Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="True">
                <Setter Property="UIElement.Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Path Data="M 0,7 L 13,7 " Canvas.Left="1" Canvas.Top="1" StrokeThickness="2" StrokeEndLineCap="Round"
              StrokeStartLineCap="Round" StrokeLineJoin="Round" Stroke="#FFB82B31"/>
      </Canvas>
    </ContentControl>
    <Border Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="3,0,15,0"
            ToolTip="{Binding WeightValueDescription}">
      <Label VerticalAlignment="Center" HorizontalAlignment="Left">
        <FrameworkElement.Style>
          <Style TargetType="{Type Label}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="True">
                <Setter Property="UIElement.IsEnabled" Value="True"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <TextBlock>
          <Run Foreground="#FFAFAEAE" Text="{Binding WeightName, Mode=OneWay}"/>
          <Run Text=": " Foreground="#FFAFAEAE"/>
          <Run Text="{Binding Weight, Mode=OneWay}"/>
        </TextBlock>
      </Label>
    </Border>
    <Border Grid.Column="2" BorderThickness="0" Background="Transparent" IsHitTestVisible="True"
            BorderBrush="{Null}" ToolTip="{Binding ResultingBiasManualModeDescription}">
      <Image Width="18" Height="18" Source="{Binding ImageSource}">
        <FrameworkElement.Style>
          <Style TargetType="{Type Image}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ManualOverride}" Value="False">
                <Setter Property="UIElement.Visibility" Value="Hidden"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding ManualOverride}" Value="True">
                <Setter Property="UIElement.Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Image>
    </Border>
    <Border Grid.Column="3" BorderThickness="0" CornerRadius="5" Margin="0,1,0,1"
            ToolTip="{Binding ResultingBiasManualModeDescription}">
      <FrameworkElement.Style>
        <Style TargetType="{Type Border}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ResultingBias}" Value="Invalid">
              <Setter Property="Border.Background" Value="Transparent"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultingBias}" Value="Neutral">
              <Setter Property="Border.Background" Value="LightGray"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultingBias}" Value="Long">
              <Setter Property="Border.Background" Value="#FF41BE9A"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultingBias}" Value="Short">
              <Setter Property="Border.Background" Value="#FFB82B31"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Enabled}" Value="False">
              <Setter Property="UIElement.IsHitTestVisible" Value="false"/>
              <Setter Property="UIElement.Opacity" Value="0.35"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Enabled}" Value="True">
              <Setter Property="UIElement.IsHitTestVisible" Value="True"/>
              <Setter Property="UIElement.Opacity" Value="1"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Label HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0"
             IsHitTestVisible="false" Background="Transparent" Content="{Binding ResultingBias}">
        <FrameworkElement.Style>
          <Style TargetType="{Type Label}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="UIElement.Opacity" Value="0.35"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="True">
                <Setter Property="UIElement.Opacity" Value="1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Label>
    </Border>
  </Grid>
</lli11lllli:dje_zG426HU5Y8N752U5TZBUUJVF6MWT4V73ZENJRRWJARDSY96Z_ejd>