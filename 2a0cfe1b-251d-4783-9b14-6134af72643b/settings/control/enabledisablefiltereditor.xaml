<lli11lllli:dje_zLCDDFCKTE5BG8B6742Q2E88S82DJDPYCNY22P6DVT2RN3EQ_ejd xmlns:lli11lllli="clr-namespace:-"
                                                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                                     xmlns:ll111l1="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="5, 0" IsEnabled="{Binding Enabled}"
              IsChecked="{Binding Value}"/>
    <Button Background="Transparent" Grid.Column="1" HorizontalAlignment="Right" Margin="0"
            Command="{Binding Path=ShowHelpCommand}" ToolTip="{Binding HelpTooltip}">
      <Control.Template>
        <ControlTemplate TargetType="{Type Button}">
          <Border ll111l1:Name="CheckMark" BorderThickness="1" BorderBrush="{Null}">
            <Image Width="20" Height="20" Source="{Binding ImageSource}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="CheckMark" Value="{DynamicResource {Static JetSystemColors.HotTrackBrushKey}}"
                      Property="Border.BorderBrush"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Control.Template>
      <FrameworkElement.Style>
        <Style TargetType="{Type Button}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Enabled}" Value="true">
              <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </Button>
  </Grid>
</lli11lllli:dje_zLCDDFCKTE5BG8B6742Q2E88S82DJDPYCNY22P6DVT2RN3EQ_ejd>