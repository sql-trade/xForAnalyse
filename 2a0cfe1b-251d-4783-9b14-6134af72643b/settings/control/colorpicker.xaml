<lli11lllli:dje_zLGAW9XYEHQ2QSVXUQRPM9KUGWBLZCBS9Q3X6M8C73FY28HZ_ejd xmlns:lli11lllli="clr-namespace:-"
                                                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                                     xmlns:lil="clr-namespace:System;assembly=System.Runtime"
                                                                     xmlns:ll111l1="http://schemas.microsoft.com/winfx/2006/xaml">
  <FrameworkElement.Resources>
    <DrawingBrush ll111l1:Key="CheckerboardBrush" Stretch="None" TileMode="Tile" AlignmentX="Left" AlignmentY="Top"
                  Viewport="0,0,10,10" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="White">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,10,10"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFBCBCBC">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,5,5"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFBCBCBC">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="5,5,5,5"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Double ll111l1:Key="ColorSelectorSize">122</Double>
    <Double ll111l1:Key="ColorSelectorSizeBorder">134</Double>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource {Static JetSystemColors.ControlDarkDarkColor}}">
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid ll111l1:Name="MainGrid" Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>
      <Grid Column="0" Row="0" Margin="5">
        <Border BorderBrush="Gray" BorderThickness="2" Background="White" HorizontalAlignment="Center"
                VerticalAlignment="Center" Width="{StaticResource ColorSelectorSizeBorder}"
                Height="{StaticResource ColorSelectorSizeBorder}"/>
        <Canvas ll111l1:Name="canvasImage" Width="{StaticResource ColorSelectorSize}"
                Height="{StaticResource ColorSelectorSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Black">
          <Rectangle Width="{StaticResource ColorSelectorSize}" Height="{StaticResource ColorSelectorSize}"
                     SnapsToDevicePixels="True">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientBrush.GradientStops>
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#FF000000" Offset="0.02"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.98"/>
                  <GradientStop Color="#FFFFFFFF" Offset="1"/>
                </GradientBrush.GradientStops>
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Width="{StaticResource ColorSelectorSize}" Height="{StaticResource ColorSelectorSize}"
                     SnapsToDevicePixels="True">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientBrush.GradientStops>
                  <GradientStop Color="#FF0000" Offset="0"/>
                  <GradientStop Color="#FFFF00" Offset="0.167"/>
                  <GradientStop Color="#00FF00" Offset="0.333"/>
                  <GradientStop Color="#00FFFF" Offset="0.5"/>
                  <GradientStop Color="#0000FF" Offset="0.667"/>
                  <GradientStop Color="#FF00FF" Offset="0.833"/>
                  <GradientStop Color="#FF0000" Offset="1"/>
                </GradientBrush.GradientStops>
              </LinearGradientBrush>
            </Shape.Fill>
            <UIElement.OpacityMask>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientBrush.GradientStops>
                  <GradientStop Color="#00FFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.02"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.47"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                  <GradientStop Color="#FFFFFFFF" Offset="0.53"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.98"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </GradientBrush.GradientStops>
              </LinearGradientBrush>
            </UIElement.OpacityMask>
          </Rectangle>
        </Canvas>
        <Canvas Width="{StaticResource ColorSelectorSize}" Height="{StaticResource ColorSelectorSize}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
          <Ellipse ll111l1:Name="ellipsePixel" Width="8" Height="8" Stroke="Black" Fill="White" StrokeThickness="1"
                   Canvas.Left="-4" Canvas.Top="-4"/>
        </Canvas>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,0,0">
        <Label Content="Preview" HorizontalAlignment="Center" Foreground="WhiteSmoke" FontWeight="Bold"
               VerticalAlignment="Center" FontSize="10"/>
        <Border Width="100" Height="80" HorizontalAlignment="Center" BorderBrush="Gray" BorderThickness="2"
                Background="{StaticResource CheckerboardBrush}">
          <Border Name="previewPresenter" BorderThickness="0" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="5">
          <Border CornerRadius="5" Background="{DynamicResource {Static JetSystemColors.ControlDarkDarkColor}}"
                  BorderBrush="Gray" BorderThickness="2" Width="112" Height="30">
            <TextBox ll111l1:Name="txtAll" BorderThickness="0" Background="Transparent" Margin="5,1,5,1"
                     IsReadOnly="True" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"
                     Foreground="WhiteSmoke"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border ll111l1:Name="AlphaBorder" Background="{StaticResource CheckerboardBrush}" Grid.Row="2"
            Grid.ColumnSpan="2" Margin="5,5,5,5" Height="32" CornerRadius="5" BorderBrush="Gray"
            BorderThickness="2">
      <Slider ll111l1:Name="AlphaSlider" Orientation="Horizontal" Minimum="0" Maximum="255" SmallChange="1"
              LargeChange="25" VerticalAlignment="Center" Margin="5" Value="255"/>
    </Border>
  </Grid>
</lli11lllli:dje_zLGAW9XYEHQ2QSVXUQRPM9KUGWBLZCBS9Q3X6M8C73FY28HZ_ejd>